{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run scripts/build/minify-snippet.ts",
    "build:harvest": "bun run scripts/build-harvest.ts",
    "gen:applier": "bun run scripts/build/gen-applier.ts",
    "gen:applier:check": "bun run scripts/build/gen-applier.ts --check",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "freeze": "bun run scripts/freeze-site.ts",
    "angel": "bun run scripts/angel-report.ts",
    "quality": "bun run scripts/audit-quality.ts",
    "build:lab": "bun run scripts/gen-detectors.ts && bun build src/adaptive-lab/adaptive.ts --outfile artifacts/lab/adaptive-lab.js --target=browser --format=iife --minify",
    "crawl": "bun run scripts/inventory-crawl.ts",
    "smoke:adaptive": "bun run scripts/adaptive-smoke.ts",
    "check:learn-mode": "bun run scripts/learn-mode-check.ts",
    "check:collector": "bun run scripts/collector-check.ts",
    "check:reorder-lab": "bun run scripts/reorder-lab.ts",
    "structure-eval": "bun run src/lib/tests/structure-eval/run.ts",
    "structure-evidence": "bun run scripts/structure-evidence.ts",
    "reco-eval": "bun run src/lib/tests/reco-eval/run.ts",
    "reco-eval:floor": "bun run src/lib/tests/reco-eval/floor-run.ts",
    "join-eval": "bun run scripts/section-join-eval/run.ts",
    "snapshot": "vitest run src/lib/tests/snapshot",
    "snapshot:update": "SNAPSHOT_UPDATE=1 vitest run src/lib/tests/snapshot",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@browserbasehq/sdk": "^2.12.0",
    "@browserbasehq/stagehand": "^3.4.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "playwright-core": "1.60.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.6.2",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.27.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jpeg-js": "^0.4.4",
    "nitro": "3.0.260603-beta",
    "playwright": "1.60.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  }
}
