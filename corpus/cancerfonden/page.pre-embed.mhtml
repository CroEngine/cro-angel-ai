@charset "utf-8";

html { font-family: Roboto, "Helvetica Neue", Helvetica, Arial, sans-serif;=
 margin: 0px; padding: 0px; }

body { margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; }

.no-focus-outline a:focus, .no-focus-outline button:focus { outline: none; =
}

#root { height: 100%; width: 100%; display: flex; flex-direction: column; a=
lign-items: flex-end; justify-content: center; }

#root.sticky { justify-content: flex-start; }

.imbox-launch { display: block; margin-right: 10px; }

.launcher-text:not(:empty) { animation: 0.28s ease 0s 1 normal both running=
 launcherTextAppear; }

.btn.sticky { border: 0px; }

.btn.sticky.right .launcher-text:not(:empty) { animation: 0.28s ease 0s 1 n=
ormal both running launcherTextAppearSticky; }

.btn.sticky.left .launcher-text:not(:empty) { animation: 0.28s ease 0s 1 no=
rmal both running launcherTextAppearSticky; }

.btn-primary { color: rgb(255, 255, 255); background-color: rgb(0, 123, 255=
); border-color: rgb(0, 123, 255); }

.btn { font-family: inherit; box-shadow: rgba(0, 0, 0, 0.06) 0px 1px 6px, r=
gba(0, 0, 0, 0.16) 0px 2px 16px; cursor: pointer; display: inline-block; fo=
nt-weight: 400; text-align: center; white-space: nowrap; vertical-align: mi=
ddle; user-select: none; border: 1px solid rgba(0, 0, 0, 0); padding: 0.375=
rem 0.75rem; font-size: 1rem; line-height: 1.5; border-radius: 0.25rem; tra=
nsition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, borde=
r-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out; }

.badge-light { color: rgb(33, 37, 41); background-color: rgb(248, 249, 250)=
; }

.badge-primary { color: rgb(255, 255, 255); background-color: rgb(252, 87, =
107); }

.badge-pill { padding-right: 0.6em; padding-left: 0.6em; border-radius: 10r=
em; }

.badge { display: inline-block; padding: 0.25em 0.4em; font-size: 75%; font=
-weight: 700; line-height: 1; text-align: center; white-space: nowrap; vert=
ical-align: baseline; border-radius: 0.25rem; }

.launcher-badge { position: absolute; top: 7px; right: 6px; background: rgb=
(252, 61, 84); width: 20px; height: 20px; line-height: 20px; border-radius:=
 50%; color: rgb(255, 255, 255); font-size: 0.75rem; font-weight: 500; text=
-align: center; }

.launcher-close { color: rgb(255, 255, 255); display: inline-block; vertica=
l-align: middle; animation: 0.16s linear 0s 1 normal both running closeAppe=
ar; }

.launcher-close .imbox-close-svg { stroke: rgb(255, 255, 255); fill: rgb(25=
5, 255, 255); stroke-width: 0; }

.launcher-close i { font-size: 155%; }

.launcher-avatar { width: 55px; height: 55px; border-radius: 50%; overflow:=
 hidden; }

.launcher-avatar img { width: 55px; height: 55px; pointer-events: none; }

.btn.sticky.left .launcher-avatar img { transform: rotate(90deg); }

.btn.sticky.right .launcher-avatar img { transform: rotate(-90deg); }

.btn.onlyAvatar { background-color: rgba(0, 0, 0, 0); box-shadow: none; pad=
ding: 0px; }

.btn.onlyAvatar .badge { position: absolute; top: 7px; right: 7px; }

