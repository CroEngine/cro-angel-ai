# environment — never committed.
.env
.env.*
!.env.example

# local Node bundles for the sandbox Browserbase runners (rebuilt on demand)
*.node.mjs

# Visual pre-flight / redesign-render evidence — generated screenshots + report,
# reproduce via scripts/preflight.ts resp. scripts/lab/redesign-render.ts.
preflight-out/
redesign-render-out/

# Repo uses bun (bun.lock); npm lockfile is local-only
package-lock.json
